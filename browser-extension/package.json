{
  "name": "ethan-browser-extension",
  "version": "0.8.2",
  "private": true,
  "description": "Ethan Browser Chrome extension (WebSocket bridge)",
  "type": "module",
  "scripts": {
    "build": "tsc -b tsconfig.json && vite build",
    "dev": "vite build --watch --mode development",
    "type-check": "tsc -b tsconfig.json --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:shortcut": "node scripts/e2e-shortcut.mjs",
    "e2e:commands": "node scripts/e2e-commands.mjs",
    "e2e": "npm run build && npm run e2e:shortcut && npm run e2e:commands && npm run e2e:record",
    "e2e:record": "node scripts/e2e-shortcut-record.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.270",
    "@types/node": "^24",
    "playwright": "^1.62.1",
    "typescript": "~5.8.2",
    "vite": "^6.3.5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "highlight.js": "^11.11.1"
  }
}
