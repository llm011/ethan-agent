{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    // types 一旦写了就只会自动包含列出的包，其余 @types/* 全部被排除。
    // react-syntax-highlighter 没有自带 d.ts，子路径（styles/prism、
    // languages/prism/*）的类型全靠 @types/react-syntax-highlighter 里的
    // declare module 提供；不显式列出它，这些 declare module 就是死代码，
    // strict 下会因 TS7016 全线报错（web 侧没设 types，所以一直没暴露）。
    "types": [
      "vite/client",
      "react-syntax-highlighter"
    ],
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "moduleDetection": "force",
    "noEmit": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@ethan/shared/ui/*": [
        "../packages/shared/src/ui/*"
      ],
      "@ethan/shared/chat/*": [
        "../packages/shared/src/chat/*"
      ],
      "@ethan/shared/lib/*": [
        "../packages/shared/src/lib/*"
      ],
      "@ethan/shared/ppt/*": [
        "../packages/shared/src/ppt/*"
      ],
      "@ethan/shared/components/*": [
        "../packages/shared/src/components/*"
      ]
    },
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src",
    "../shared"
  ]
}
